APP_ENV=local
VIGIL_MODEL=gemini-2.5-flash
VIGIL_REASONING_MODEL=gemini-2.5-pro
VIGIL_RETRIEVAL_BACKEND=local
VIGIL_RETRIEVAL_TOP_K=6
VIGIL_RETRIEVAL_MIN_SCORE=0.08
VIGIL_RAG_CORPUS=
VIGIL_RAG_DISTANCE_THRESHOLD=0.5
VIGIL_MEMORY_BACKEND=local
VIGIL_AUDIT_LOG_PATH=.vigil/audit.jsonl
VIGIL_DECISION_STORE_PATH=.vigil/decisions.jsonl
VIGIL_SOURCE_BACKEND=mock
VIGIL_ACTION_BACKEND=mock
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
